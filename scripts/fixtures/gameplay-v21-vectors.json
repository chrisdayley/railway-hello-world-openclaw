  "scenarios": [
    {
      "id": "enemy-telegraph-timing",
      "initial": {
        "enemy": {
          "id": "wisp-telegraph",
          "kind": "wisp",
          "x": 560,
          "y": 397,
          "dead": false,
          "phase": "windup",
          "phaseElapsedMs": 0,
          "durations": { "windup": 420, "strike": 120, "recover": 580 },
          "strikeStarted": false,
          "hitResolved": false
        }
      },
      "actions": [
        { "type": "step", "ms": 419, "expect": { "clockMs": 419, "enemy": { "phase": "windup", "phaseElapsedMs": 419, "strikeStarted": false } } },
        { "type": "step", "ms": 1, "expect": { "clockMs": 420, "enemy": { "phase": "strike", "phaseElapsedMs": 0, "strikeStarted": true } } },
        { "type": "step", "ms": 119, "expect": { "clockMs": 539, "enemy": { "phase": "strike", "phaseElapsedMs": 119, "hitResolved": false } } },
        { "type": "step", "ms": 1, "expect": { "clockMs": 540, "enemy": { "phase": "recover", "phaseElapsedMs": 0, "hitResolved": true } } },
        { "type": "step", "ms": 579, "expect": { "clockMs": 1119, "enemy": { "phase": "recover", "phaseElapsedMs": 579 } } },
        { "type": "step", "ms": 1, "expect": { "clockMs": 1120, "enemy": { "phase": "chase", "phaseElapsedMs": 0 } } }
      ]
    },
    {
      "id": "loot-drop-and-pickup",
      "initial": {
        "enemy": { "id": "wisp-0", "kind": "wisp", "x": 540, "y": 390, "dead": false },
        "player": { "gold": 35, "pickups": 0 },
        "world": { "loot": [] }
      },
      "actions": [
        { "type": "command", "name": "enemy.kill", "payload": { "enemyId": "wisp-0", "dropId": "drop-wisp-0", "kind": "gold", "amount": 9 }, "expect": { "enemy": { "dead": true }, "player": { "gold": 35 }, "world": { "loot": [{ "id": "drop-wisp-0", "kind": "gold", "amount": 9, "x": 540, "y": 390 }] } } },
        { "type": "command", "name": "loot.pickup", "payload": { "id": "drop-wisp-0" }, "expect": { "player": { "gold": 44, "pickups": 1 }, "world": { "loot": [] } } }
      ]
    },
    {
      "id": "camera-safe-zone-tracking",
      "initial": {
        "player": { "x": 640, "y": 350 },
        "world": { "camera": { "x": 0, "y": 0 } }
      },
      "actions": [
        { "type": "command", "name": "player.move", "payload": { "x": 640, "y": 350 }, "expect": { "world": { "camera": { "x": 0, "y": 0 } } } },
        { "type": "command", "name": "player.move", "payload": { "x": 800, "y": 400 }, "expect": { "world": { "camera": { "x": 128, "y": 22 } } } },
        { "type": "command", "name": "player.move", "payload": { "x": 1880, "y": 1000 }, "expect": { "world": { "camera": { "x": 960, "y": 540 } } } }
      ]
    },
    {
