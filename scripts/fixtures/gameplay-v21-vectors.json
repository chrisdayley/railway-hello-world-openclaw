      "initial": {
        "player": { "x": 900, "y": 350 },
        "world": { "zone": "northford", "previousZone": null, "transitionCount": 0 }
      },
      "actions": [
        { "type": "command", "name": "player.move", "payload": { "x": 1000, "y": 350 }, "expect": { "world": { "zone": "greenwake", "previousZone": "northford", "transitionCount": 1 } } },
        { "type": "command", "name": "player.move", "payload": { "x": 1100, "y": 350 }, "expect": { "world": { "zone": "greenwake", "transitionCount": 1 } } },
        { "type": "command", "name": "player.move", "payload": { "x": 900, "y": 350 }, "expect": { "world": { "zone": "northford", "previousZone": "greenwake", "transitionCount": 2 } } }
